{
    "name": "hideyukimori/tagmark",
    "description": "FT12-A: Bookmark + Tag M:N API — NENE2 field trial",
    "type": "project",
    "require": {
        "php": ">=8.4.1 <9.0",
        "hideyukimori/nene2": "^1.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Tagmark\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tagmark\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --testdox",
        "analyse": "vendor/bin/phpstan analyse --level=8 src tests",
        "cs": "vendor/bin/php-cs-fixer check --diff",
        "cs:fix": "vendor/bin/php-cs-fixer fix",
        "check": [
            "@test",
            "@analyse",
            "@cs"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
